# ============================================================
#  Voice Cohort Record (VCR) - environment configuration
#  Copy this file to ".env" and fill in your own values.
#  Do NOT commit the real ".env" - it contains secrets.
# ============================================================


# ===== DATABASE =====
# PostgreSQL connection string used by SQLAlchemy.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://cohort_user:CHANGE_ME@localhost:5432/vcr_db


# ===== Gemini AI =====
# Comma-separated list of Google Gemini API keys.
# Multiple keys are used in round-robin for quota failover.
# A single key may also be placed in GOOGLE_API_KEY.
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_HERE
# GOOGLE_API_KEY=

# Comma-separated fallback models tried when the primary model is overloaded
# (HTTP 503, "high demand" responses). Used together with the default model
# defined in app/core/config.py (gemini-3-flash-preview).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional override for the model used by the health-check feature.
# GEMINI_HEALTH_MODEL=gemini-3.1-flash-lite

# Outbound HTTP timeout (milliseconds) for Gemini calls.
GENAI_TIMEOUT_MS=90000

# Retry tuning for transient overload and quota errors.
GENAI_RETRY_BACKOFF_SECONDS=1.5
GENAI_OVERLOAD_RETRIES=1


# ===== OUTBOUND PROXY =====
# Optional HTTP(S) proxy used for both Gemini calls and the in-app CDN proxy.
# GENAI_PROXY=http://127.0.0.1:10888
# HTTP_PROXY=
# HTTPS_PROXY=


# ===== EMAIL (Brevo) =====
# Used to send password-reset / verification emails. If MAIL_ENABLED is
# "false" the app skips sending entirely.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=VCR
MAIL_ENABLED=false


# ===== APP =====
# Public URL where the app is reachable from a browser. Used in email links.
APP_BASE_URL=http://127.0.0.1:8000
